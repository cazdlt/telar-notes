# Copy to .env on the server and adjust values for your host.
VAULT_PATH=/path/to/your/vault
TELAR_CONFIG_PATH=/path/to/telar-config
TELAR_PORT=7731
# Leave blank to auto-detect from `id -u` / `id -g` in scripts/deploy.sh
TELAR_UID=
TELAR_GID=
# Comma-separated extra hosts allowed behind a private reverse proxy / VPN
TELAR_ALLOWED_HOSTS=
